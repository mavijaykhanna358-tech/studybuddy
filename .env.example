# StudyBuddy environment configuration
#
# Copy to `.env` and adjust. `.env` is gitignored.
#
# Every variable below has a working default, so a fresh clone
# runs with `python manage.py runserver` and no `.env` at all.
# Real environment variables (shell, CI, hosting) take priority
# over this file.

# ============================================================
# DEBUG AND ENVIRONMENT
# ============================================================

# `development`  -> DEBUG defaults to True
# `production`   -> DEBUG defaults to False
DJANGO_ENV=development

# Overrides the DEBUG default above. Set it explicitly if you
# want, for example, DEBUG=True against a staging deployment.
# DEBUG=True

# ============================================================
# SECRET KEY
# ============================================================

# Required whenever DEBUG is off. Must be at least 50 characters
# or Django refuses to start:
#
#   python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
#
# Never reuse the value across environments. Changing it signs
# out every user and invalidates outstanding password reset links.
# SECRET_KEY=replace-with-a-long-random-string-of-at-least-50-characters

# ============================================================
# HOSTS AND CSRF
# ============================================================

# Comma separated. `localhost` and `127.0.0.1` are the default.
# ALLOWED_HOSTS=localhost,127.0.0.1,your-app-name.onrender.com

# Only needed for HTTPS domains that are not in ALLOWED_HOSTS.
# Each entry needs a scheme.
# CSRF_TRUSTED_ORIGINS=https://your-app-name.onrender.com

# ============================================================
# DATABASE
# ============================================================

# Leave unset to use the bundled SQLite file (db.sqlite3).
# Set it to point at a managed database instead.
# DATABASE_URL=postgresql://user:password@host:5432/dbname

# ============================================================
# EMAIL
# ============================================================

# Resend API key. Without it, email is printed to the console by
# Django's console backend rather than silently disappearing.
# RESEND_API_KEY=re_your_resend_api_key

# Sender shown on outgoing mail.
# DEFAULT_FROM_EMAIL=StudyBuddy <onboarding@resend.dev>

# The public address of the site. Password reset links are built
# from this, so a reset email keeps working when the app is
# reached through a hostname other than the one the request came
# in on. Use the real https address in production.
# FRONTEND_BASE_URL=http://localhost:8000

# ============================================================
# NOTE ATTACHMENTS
# ============================================================

# Leave any value empty to store attachments on local disk under
# MEDIA_ROOT instead of uploading them to Cloudinary.
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=
