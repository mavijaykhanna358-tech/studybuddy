# StudyBuddy environment configuration
#
# Copy to `.env` and adjust. `.env` is gitignored.
#
# Every variable below has a working default, so a fresh clone
# runs with `python manage.py runserver` and no `.env` at all.
# Real environment variables (shell, CI, hosting) take priority
# over this file.

# ============================================================
# DEBUG AND ENVIRONMENT
# ============================================================

# `development`  -> DEBUG defaults to True
# `production`   -> DEBUG defaults to False
DJANGO_ENV=development

# Overrides the DEBUG default above. Set it explicitly if you
# want, for example, DEBUG=True against a staging deployment.
# DEBUG=True

# ============================================================
# SECRET KEY
# ============================================================

# Required whenever DEBUG is off. Must be at least 50 characters
# or Django refuses to start:
#
#   python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
#
# Never reuse the value across environments. Changing it signs
# out every user and invalidates outstanding password reset links.
# SECRET_KEY=replace-with-a-long-random-string-of-at-least-50-characters

# ============================================================
# HOSTS AND CSRF
# ============================================================

# Comma separated. `localhost` and `127.0.0.1` are the default.
# ALLOWED_HOSTS=localhost,127.0.0.1,your-app-name.onrender.com

# Only needed for HTTPS domains that are not in ALLOWED_HOSTS.
# Each entry needs a scheme.
# CSRF_TRUSTED_ORIGINS=https://your-app-name.onrender.com

# ============================================================
# DATABASE
# ============================================================

# Leave unset in development to use the bundled SQLite file
# (db.sqlite3).
#
# On Render, set this to your PostgreSQL connection string:
#
#   postgresql://USER:PASSWORD@HOST:5432/DBNAME
#
# Render fills this in automatically once a PostgreSQL database is
# linked to the service under Dashboard > Connect.
#
# It is REQUIRED when DJANGO_ENV is `production`. A production
# process with no DATABASE_URL refuses to start rather than
# falling back to SQLite, because Render's disk is ephemeral and
# every row would be lost on the next deploy.
# DATABASE_URL=postgresql://user:password@host:5432/dbname

# Forces `sslmode=require` on the database connection. Off by
# default, because Render's internal database does not terminate
# TLS. A `?sslmode=require` already in DATABASE_URL is honoured
# either way, so Render's external connection string still uses TLS.
# Set to True only for a managed database that demands encryption.
# DATABASE_SSL_REQUIRE=False

# Overrides the fallback engine. The default is SQLite in
# development and nothing in production. Set it explicitly only
# for a deliberate SQLite deployment.
# DATABASE_FALLBACK_ENGINE=django.db.backends.sqlite3

# ============================================================
# EMAIL
# ============================================================

# Resend API key. Without it, email is printed to the console by
# Django's console backend rather than silently disappearing. This
# fallback is development only: in production the Resend backend is
# always selected and a missing key fails the system check, because
# a printed-and-discarded email looks exactly like a delivered one.
# RESEND_API_KEY=re_your_resend_api_key

# Sender shown on outgoing mail. It must be an address on a domain
# you have verified in Resend. The default below is Resend's shared
# testing address, which only delivers to the account owner's own
# inbox and is rejected with a 403 for every other recipient, so a
# production deployment must replace it.
# DEFAULT_FROM_EMAIL=StudyBuddy <no-reply@your-verified-domain>

# Optional. Only needed to leave Resend for another provider, for
# example SMTP. Do NOT set this in production unless the backend
# really delivers: console, locmem, filebased and dummy are ignored
# in production and the Resend backend is used instead, which is
# reported as the studybuddy.email_backend_ignored check warning.
# Setting it to the console backend is what stopped password reset
# email being delivered, because the message was printed into the
# gunicorn log and discarded.
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend

# The public address of the site. Password reset links are built
# from this, so a reset email keeps working when the app is
# reached through a hostname other than the one the request came
# in on. Use the real https address in production.
# FRONTEND_BASE_URL=http://localhost:8000

# ============================================================
# ADMIN PROVISIONING
# ============================================================
#
# Render Shell is a paid feature, so on a free plan the production
# database is reachable only through a build. `manage.py
# provision_admin`, which build.sh already calls, creates or promotes
# one administrator from these three variables.
#
# Set them on the service, deploy once, then DELETE them. Do not
# leave ADMIN_PASSWORD in place: the command deliberately refuses to
# set the password of an account that already exists, so a stale
# value is harmless rather than a reset on every deploy.
#
# With no ADMIN_USERNAME the command does nothing and succeeds, so
# it is safe to keep wired into build.sh permanently. The password
# is never written to the build log, and must satisfy Django's
# password validators or the build fails.

# ADMIN_USERNAME=siteadmin
# ADMIN_EMAIL=admin@your-verified-domain

# Only needed the first time, while the account does not exist yet.
# Once it does, promoting it needs no password at all.
# ADMIN_PASSWORD=

# ============================================================
# NOTE ATTACHMENTS
# ============================================================

# Leave any value empty to store attachments on local disk under
# MEDIA_ROOT instead of uploading them to Cloudinary.
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=
